<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 picker preview mirroring the widget's small card; keep it in step with ClassWidget.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:contentDescription="@string/widget_preview_class_description"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_preview_hero"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/widget_preview_class_status"
            android:textColor="@color/widget_preview_primary_container"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Pushes the headline to the bottom of the card. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:ignore="UselessLeaf" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_preview_class_lead"
            android:textColor="@color/widget_preview_on_primary_container"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/widget_preview_class_minutes"
                android:textColor="@color/widget_preview_on_primary_container"
                android:textSize="34sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="@string/widget_preview_minutes_unit"
                android:textColor="@color/widget_preview_on_primary_container"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_preview_class_course"
            android:textColor="@color/widget_preview_on_primary_container"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
